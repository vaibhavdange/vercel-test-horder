generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Product {
  id            String      @id @default(cuid())
  barcode       String?     @unique
  name          String
  description   String?
  price         Float
  cost          Float?
  categoryId    String?
  taxCategoryId String?     // New: Reference to tax category
  stockQuantity Int         @default(0)
  minStockLevel Int         @default(0)
  taxRate       Float       @default(0.0) // Keep for backward compatibility
  serviceChargeRate Float   @default(0.0) // New: Product-level service charge rate
  image         String?     // New: Image URL or file path
  thumbnail     String?     // New: Thumbnail image path for faster loading
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  category      Category?   @relation(fields: [categoryId], references: [id])
  taxCategory   TaxCategory? @relation(fields: [taxCategoryId], references: [id]) // New relation
  orderItems    OrderItem[]
  recipes       Recipe[]    // Recipes that use this product
  extras        ProductExtra[]

  @@map("products")
}

// New model for inventory categories (separate from menu categories)
model InventoryCategory {
  id          String      @id @default(cuid())
  name        String      // e.g., "Dairy", "Produce", "Pantry", "Meat", "Beverages"
  description String?
  icon        String      @default("📦")
  color       String      @default("#3B82F6") // Hex color for visual distinction
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Relationships
  stockItems  StockItem[] // Stock items in this category
  
  @@map("inventory_categories")
}

// New model for ingredients (raw materials) - renamed to StockItem
model StockItem {
  id            String      @id @default(cuid())
  name          String      // e.g., "Flour", "Tomatoes", "Olive Oil"
  description   String?     // e.g., "All-purpose flour", "Fresh Roma tomatoes"
  unit          String      // e.g., "kg", "pieces", "liters"
  costPerUnit   Float       // Cost per unit
  stockQuantity Float       @default(0) // Current stock level
  minStockLevel Float       @default(0) // Minimum stock level
  supplier      String?     // Supplier information
  location      String?     // Storage location
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relationships
  recipeItems   RecipeItem[] // Used in recipes
  category      InventoryCategory? @relation(fields: [categoryId], references: [id])
  categoryId    String?     // Inventory category (e.g., "Dairy", "Produce", "Pantry")
  extras        ProductExtra[]

  @@map("stock_items")
}

// New model for recipes (how ingredients make menu items)
model Recipe {
  id          String        @id @default(cuid())
  name        String        // e.g., "Margherita Pizza Recipe"
  description String?       // Recipe description
  productId   String        // The menu item this recipe creates
  servings    Int           @default(1) // Number of servings this recipe makes
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relationships
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  items       RecipeItem[]  // Ingredients and quantities

  @@map("recipes")
}

// Junction table for recipe ingredients
model RecipeItem {
  id           String     @id @default(cuid())
  recipeId     String
  stockItemId  String?    // Optional reference to stock item
  quantity     Float      // Amount needed
  unit         String     // Unit of measurement
  notes        String?    // Any special notes
  
  // Relationships
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stockItem    StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@map("recipe_items")
}

// Optional paid add-ons that can be toggled per order item
model ProductExtra {
  id          String     @id @default(cuid())
  productId   String
  stockItemId String?
  name        String      // Display name for the extra (copied from stock item or custom)
  price       Float       @default(0.0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@map("product_extras")
}

model Category {
  id          String      @id @default(cuid())
  name        String
  description String?
  icon        String      @default("🍴")
  parentId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

// New model for tax categories and rates
model TaxCategory {
  id          String      @id @default(cuid())
  name        String      // e.g., "Food", "Beverages", "Alcohol", "Desserts"
  description String?
  taxRate     Float       @default(0.0) // Tax rate as decimal (e.g., 0.08 for 8%)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Relationships
  products    Product[]   // Products that use this tax category
  
  @@map("tax_categories")
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  kotNumber        Int?          // Sequential KOT number for the day
  orderType        String        @default("dine-in") // dine-in, takeaway, delivery
  tableId          String?       // Reference to Table model
  tableNumber      String?       // Keep for backward compatibility
  customerId       String?
  customerName     String?
  customerPhone    String?
  status           String        @default("pending") // pending, in-process, ready, completed, cancelled
  subStatus      String?
  subtotal       Float
  taxAmount      Float          @default(0.0)
  serviceChargeAmount Float     @default(0.0) // New: Service charge amount
  serviceChargeRate Float       @default(0.0) // New: Service charge percentage
  discountAmount Float          @default(0.0)
  totalAmount    Float
  paymentStatus  String         @default("pending") // pending, paid, refunded
  paymentMethod  String?
  notes          String?
  createdAt      DateTime      @default(now())
  startedCookingAt DateTime?
  readyAt        DateTime?
  updatedAt      DateTime      @updatedAt
  customer       Customer?     @relation(fields: [customerId], references: [id])
  table          Table?        @relation(fields: [tableId], references: [id])
  orderItems     OrderItem[]
  transactions   Transaction[]
  refunds        Refund[]      // New: Refunds for this order

  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  productId          String
  productName        String
  quantity           Int
  unitPrice          Float
  totalPrice         Float
  customizationNotes String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Transaction {
  id                String    @id @default(cuid())
  transactionNumber String    @unique
  orderId           String?   @unique
  totalAmount       Float
  taxAmount         Float     @default(0.0)
  discountAmount    Float     @default(0.0)
  paymentMethod     String
  paymentStatus     String    @default("completed")
  cashierId         String?
  customerId        String?
  transactionDate   DateTime  @default(now())
  items             String
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  customer          Customer? @relation(fields: [customerId], references: [id])
  cashier           User?     @relation("CashierTransactions", fields: [cashierId], references: [id])
  order             Order?    @relation(fields: [orderId], references: [id])
  refunds           Refund[]  // New: Refunds for this transaction

  @@map("transactions")
}

// New model for refunds
model Refund {
  id                String    @id @default(cuid())
  refundNumber      String    @unique
  orderId           String
  transactionId     String
  refundAmount      Float
  refundReason      String?   // e.g., "Customer not satisfied", "Wrong order", "Quality issue"
  refundMethod      String    // cash, card, voucher, store_credit
  refundStatus      String    @default("pending") // pending, processed, completed, failed
  cashierId         String?
  customerId        String?
  refundDate        DateTime  @default(now())
  refundedItems     String?   // JSON string of refunded items
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relationships
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  cashier           User?     @relation("CashierRefunds", fields: [cashierId], references: [id])
  customer          Customer? @relation(fields: [customerId], references: [id])

  @@map("refunds")
}

model Customer {
  id             String        @id @default(cuid())
  name           String
  email          String?       @unique
  phone          String?       @unique
  address        String?
  loyaltyPoints  Int           @default(0)
  totalPurchases Float         @default(0.0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orders         Order[]
  transactions   Transaction[]
  refunds        Refund[]      // New: Refunds for this customer
  reservations   Reservation[] @relation("CustomerReservations")

  @@map("customers")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  fullName     String
  email        String        @unique
  phone        String?
  role         String        @default("cashier")
  isActive     Boolean       @default(true)
  lastLogin    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[] @relation("CashierTransactions")
  refunds      Refund[]     @relation("CashierRefunds") // New: Refunds processed by this user
  staff        Staff?       @relation("UserStaff")

  @@map("users")
}

model Staff {
  id              String    @id @default(cuid())
  userId          String    @unique
  employeeId      String    @unique
  profilePicture  String?
  dateOfBirth     DateTime?
  salary          Float?
  shiftStart      String?   // Format: "09:00"
  shiftEnd        String?   // Format: "17:00"
  address         String?
  additionalDetails String?
  hireDate        DateTime  @default(now())
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation("UserStaff", fields: [userId], references: [id], onDelete: Cascade)
  attendance      StaffAttendance[]

  @@map("staff")
}

model StaffAttendance {
  id        String   @id @default(cuid())
  staffId   String
  date      DateTime
  status    String   // 'present', 'absent', 'half-shift', 'leave'
  checkIn   DateTime?
  checkOut  DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@map("staff_attendance")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Reservation {
  id              String    @id @default(cuid())
  customerName    String
  customerPhone   String?
  customerEmail   String?
  reservationDate DateTime
  reservationTime String    // Format: "18:00"
  partySize       Int
  tableNumber     String?
  tableId         String?   // Reference to Table model
  specialRequests String?
  status          String    @default("confirmed") // confirmed, seated, completed, cancelled, no-show
  customerId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  customer        Customer? @relation("CustomerReservations", fields: [customerId], references: [id])
  table           Table?    @relation(fields: [tableId], references: [id])

  @@map("reservations")
}

model Floor {
  id          String   @id @default(cuid())
  name        String   // e.g., "Ground Floor", "First Floor", "Outdoor"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationships
  tables      Table[]
  areas       Area[]

  @@map("floors")
}

model Area {
  id          String   @id @default(cuid())
  name        String   // e.g., "A/C", "Non A/C", "Bar", "VIP"
  description String?
  floorId     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationships
  floor       Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  tables      Table[]

  @@map("areas")
}

model Table {
  id          String   @id @default(cuid())
  tableNumber String   // e.g., "1", "2", "VIP-1"
  capacity    Int
  areaId      String
  floorId     String
  status      String   @default("available") // available, occupied, reserved, cleaning, unavailable
  displayOrder Int     @default(0) // New: Order for drag and drop positioning
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationships
  area        Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  floor       Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  orders      Order[]
  reservations Reservation[]

  @@map("tables")
}

// New model for system-wide billing settings
model BillingSettings {
  id                    String      @id @default(cuid())
  key                   String      @unique // e.g., "default_service_charge_rate", "default_tax_rate"
  value                 String      // JSON string of the setting value
  description           String?
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  @@map("billing_settings")
}
